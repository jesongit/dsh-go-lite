<?xml version="1.0" encoding="utf-8"?>
<!-- Keep parallel-install shortcuts inside this package; the activity namespace is shared. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat">
        <intent
            android:action="io.github.ccch1mneyyy.dsh_app.action.NEW_CHAT"
            android:targetClass="io.github.ccch1mneyyy.dsh_app.shortcuts.EntryActivity"
            android:targetPackage="io.github.ccch1mneyyy.dsh_app.remote_test" />
    </shortcut>
    <shortcut
        android:shortcutId="voice_input"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice_input"
        android:shortcutLongLabel="@string/shortcut_voice_input">
        <intent
            android:action="io.github.ccch1mneyyy.dsh_app.action.VOICE_INPUT"
            android:targetClass="io.github.ccch1mneyyy.dsh_app.shortcuts.EntryActivity"
            android:targetPackage="io.github.ccch1mneyyy.dsh_app.remote_test" />
    </shortcut>
</shortcuts>
